<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minha Empresa</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, sans-serif;
    background:#f6f7fb;
    color:#171923;
    line-height:1.5;
}

a{
    text-decoration:none;
    color:inherit;
}

/* HEADER */

header{
    position:sticky;
    top:0;
    z-index:10;
    background:#fff;
    border-bottom:1px solid #e8e9ef;
}

.nav{
    max-width:1180px;
    height:72px;
    margin:auto;
    padding:0 22px;

    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:24px;
    font-weight:800;
}

.logo span{
    color:#2563eb;
}

nav{
    display:flex;
    gap:28px;
    font-size:14px;
    font-weight:600;
}

nav a:hover{
    color:#2563eb;
}

/* BOTÕES */

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    padding:13px 20px;

    border-radius:10px;
    font-weight:700;

    border:0;
    cursor:pointer;
}

.primary{
    background:#2563eb;
    color:#fff;
}

.secondary{
    background:#eef3ff;
    color:#2563eb;
}

/* HERO */

.hero{
    background:linear-gradient(135deg,#111827,#1f2937);
    color:white;
}

.hero-inner{
    max-width:1180px;
    margin:auto;

    padding:92px 22px 100px;

    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:55px;

    align-items:center;
}

.tag{
    display:inline-block;

    background:#ffffff18;
    border:1px solid #ffffff25;

    padding:7px 12px;

    border-radius:30px;

    font-size:12px;
    font-weight:700;

    margin-bottom:20px;
}

h1{
    font-size:clamp(42px,6vw,68px);
    line-height:1.02;

    letter-spacing:-3px;

    margin-bottom:22px;
}

.hero p{
    font-size:18px;
    color:#d1d5db;

    max-width:590px;

    margin-bottom:30px;
}

.actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.hero-card{
    height:350px;

    border-radius:22px;

    background:linear-gradient(145deg,#374151,#111827);

    border:1px solid #ffffff18;

    display:flex;
    align-items:center;
    justify-content:center;

    box-shadow:0 25px 70px #0005;
}

.hero-card div{
    text-align:center;
    color:#9ca3af;
}

.hero-card strong{
    display:block;

    font-size:70px;

    color:#fff;
}

/* SEÇÕES */

section{
    max-width:1180px;
    margin:auto;

    padding:78px 22px;
}

.eyebrow{
    font-size:12px;

    text-transform:uppercase;

    letter-spacing:2px;

    color:#2563eb;

    font-weight:800;

    margin-bottom:9px;
}

h2{
    font-size:36px;

    letter-spacing:-1.5px;

    margin-bottom:12px;
}

.section-head{
    margin-bottom:32px;
}

.section-head p{
    color:#69707d;

    max-width:650px;
}

/* SERVIÇOS */

.grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:18px;
}

.card{
    background:#fff;

    border:1px solid #e7e9ef;

    border-radius:16px;

    padding:25px;

    box-shadow:0 8px 30px #11182708;
}

.icon{
    width:46px;
    height:46px;

    border-radius:12px;

    background:#eef3ff;

    color:#2563eb;

    display:grid;
    place-items:center;

    font-size:15px;
    font-weight:bold;

    margin-bottom:17px;
}

.card h3{
    font-size:19px;

    margin-bottom:7px;
}

.card p{
    color:#6b7280;

    font-size:14px;
}

/* SOBRE */

.about{
    background:#fff;
}

.about-inner{
    max-width:1180px;

    margin:auto;

    padding:78px 22px;

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:65px;

    align-items:center;
}

.mock-photo{
    height:330px;

    border-radius:20px;

    background:linear-gradient(
        135deg,
        #dbeafe,
        #e5e7eb
    );

    display:grid;

    place-items:center;

    color:#64748b;

    font-weight:700;
}

.checks{
    display:grid;

    gap:13px;

    margin-top:22px;
}

.checks span{
    color:#2563eb;

    font-weight:900;

    margin-right:8px;
}

/* GALERIA */

.gallery{
    grid-template-columns:repeat(3,1fr);
}

.photo{
    height:210px;

    border-radius:15px;

    background:linear-gradient(
        135deg,
        #dbeafe,
        #cbd5e1
    );

    display:grid;

    place-items:center;

    color:#64748b;

    font-size:13px;
}

/* CONTATO */

.contact{
    background:#111827;

    color:#fff;

    max-width:none;
}

.contact-inner{
    max-width:1180px;

    margin:auto;

    padding:78px 22px;

    display:flex;

    justify-content:space-between;

    gap:30px;

    align-items:center;
}

.contact p{
    color:#cbd5e1;

    max-width:620px;
}

/* PAINEL */

.admin{
    background:#eef1f7;
}

.admin-wrap{
    max-width:1180px;

    margin:auto;

    padding:70px 22px;
}

.admin-top{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;
}

.admin-grid{
    display:grid;

    grid-template-columns:220px 1fr;

    gap:18px;
}

.side,
.panel{
    background:#fff;

    border:1px solid #e3e6ed;

    border-radius:15px;

    padding:18px;
}

.side div{
    padding:12px;

    border-radius:9px;

    font-weight:600;

    font-size:14px;
}

.side .active{
    background:#eef3ff;

    color:#2563eb;
}

.panel h3{
    margin-bottom:18px;
}

.stats{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:12px;
}

.stat{
    border:1px solid #e7e9ef;

    border-radius:12px;

    padding:18px;
}

.stat small{
    color:#737b88;
}

.stat strong{
    display:block;

    font-size:27px;

    margin-top:5px;
}

/* FOOTER */

footer{
    background:#0b1120;

    color:#9ca3af;

    padding:28px 22px;

    font-size:13px;
}

.foot{
    max-width:1180px;

    margin:auto;

    display:flex;

    justify-content:space-between;
}

/* CELULAR */

@media(max-width:800px){

    nav{
        display:none;
    }

    .hero-inner,
    .about-inner{
        grid-template-columns:1fr;
    }

    .hero-card{
        height:250px;
    }

    .grid,
    .gallery{
        grid-template-columns:1fr;
    }

    .contact-inner{
        display:block;
    }

    .contact .btn{
        margin-top:20px;
    }

    .admin-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr;
    }

    h1{
        letter-spacing:-2px;
    }
}
</style>
</head>

